# Copy to .env and fill in. .env is git-ignored — never commit real credentials.
# Tuning (species, windows, thresholds) lives in config/config.yaml; this file is for
# connection details, secrets and machine-specific settings.

# ── Database (Antz Dev MySQL) ────────────────────────────────────────────────
# Use a READ-ONLY user. The pipeline only reads, and extracts to data/raw/ once.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Path to CA cert if the server requires TLS; leave empty otherwise
DB_SSL_CA=

# ── Optional: SSH tunnel (if Dev DB is only reachable via a bastion) ─────────
# Leave SSH_HOST empty to connect directly.
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=~/.ssh/id_rsa
# Local port the tunnel binds to; set DB_HOST=127.0.0.1 and DB_PORT to this value when tunnelling
SSH_LOCAL_PORT=13306

# ── Zoo scope ────────────────────────────────────────────────────────────────
# The one zoo we extract and backtest on
ZOO_ID=
# IANA timezone of that zoo, used to turn UTC timestamps into local days (e.g. Asia/Kolkata)
ZOO_TIMEZONE=Asia/Kolkata

# ── Self-hosted LLM (Ollama) for keeper notes ────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
# Used when the main model is too slow on this machine
LLM_FALLBACK_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=60

# ── Paths (relative to health-animal/) ───────────────────────────────────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
OUTPUTS_DIR=outputs

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
